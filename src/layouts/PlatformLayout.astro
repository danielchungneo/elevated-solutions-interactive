---
import "../styles/platform.css";

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  ogImage?: string;
}

const {
  title,
  description,
  canonicalPath = Astro.url.pathname,
  jsonLd,
  ogImage,
} = Astro.props;

const canonical = new URL(canonicalPath, Astro.site ?? Astro.url).href;
const og =
  ogImage != null
    ? new URL(ogImage, Astro.site ?? Astro.url).href
    : undefined;

const jsonLdBlocks = jsonLd
  ? Array.isArray(jsonLd)
    ? jsonLd
    : [jsonLd]
  : [];
---

<!doctype html>
<html lang="en" data-theme="platform">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F3F4F1" />
    <meta name="color-scheme" content="light" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    {og && <meta property="og:image" content={og} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500..800&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@500;600&display=swap"
    />
    <title>{title}</title>
    {
      jsonLdBlocks.map((block) => (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(block)}
        />
      ))
    }
  </head>
  <body style="margin:0;background:#F3F4F1;">
    <div class="platform-root">
      <slot />
    </div>
  </body>
</html>
