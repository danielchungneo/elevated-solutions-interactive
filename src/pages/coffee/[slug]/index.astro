---
import CoffeeLayout from "../../../layouts/CoffeeLayout.astro";
import CoffeeHeader from "../../../components/coffee/CoffeeHeader.astro";
import CoffeeFooter from "../../../components/coffee/CoffeeFooter.astro";
import DrinkTile from "../../../components/coffee/DrinkTile.astro";
import CoffeeIngredients from "../../../components/coffee/Ingredients";
import MethodSwitcher from "../../../components/coffee/MethodSwitcher";
import {
  coffeeBrand,
  coffeeRecipeJsonLd,
  fToC,
  getAllCoffee,
  getRelatedCoffee,
  titleCaseTag,
} from "../../../lib/coffee";

export async function getStaticPaths() {
  const drinks = await getAllCoffee();
  return drinks.map((c) => ({
    params: { slug: c.id },
    props: { entry: c },
  }));
}

const { entry } = Astro.props;
const { data } = entry;
const slug = entry.id;
const related = await getRelatedCoffee(data.relatedSlugs);
const path = `/coffee/${slug}`;
const pageUrl = new URL(path, Astro.site ?? Astro.url).href;
const jsonLd = coffeeRecipeJsonLd(data, pageUrl);
const flavorAxes = data.flavorProfile
  ? (Object.entries(data.flavorProfile) as [string, number][])
  : [];

function altLabel(item: string, alternative: string): string {
  if (/machine/i.test(item)) return `No machine? ${alternative}`;
  if (/grinder/i.test(item)) return `No grinder? ${alternative}`;
  return alternative;
}
---

<CoffeeLayout
  title={data.seo.title}
  description={data.seo.description}
  canonicalPath={path}
  jsonLd={jsonLd}
  ogImage={data.heroImage}
>
  <CoffeeHeader />

  <section aria-labelledby="drink-name" class="title">
    <svg width="40" height="28" viewBox="0 0 40 28" fill="none" stroke="var(--color-accent)" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 26c-4-4 4-7 0-11s4-7 0-11"></path><path d="M20 26c-4-4 4-7 0-11s4-7 0-11"></path><path d="M28 26c-4-4 4-7 0-11s4-7 0-11"></path></svg>
    <h1 id="drink-name">{data.name}</h1>
    <p class="title__tagline">{data.tagline}</p>
    <ul aria-label="Tags" class="title__tags">
      {data.tags.map((t) => <li>{titleCaseTag(t)}</li>)}
    </ul>
  </section>

  <section aria-label="Illustration" class="hero">
    <figure>
      <div class="hero__inset" aria-hidden="true"></div>
      {
        data.heroImage && (
          <img
            src={data.heroImage}
            alt={data.heroAlt ?? data.name}
            width="310"
            height="276"
            fetchpriority="high"
          />
        )
      }
      <figcaption>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M8 8.5a5 5 0 0 1 0 7"></path><path d="M11.5 6a8.5 8.5 0 0 1 0 12"></path><path d="M15 3.5a12 12 0 0 1 0 17"></path></svg>
        {coffeeBrand.heroLabel}
      </figcaption>
    </figure>
  </section>

  <main>
    <section aria-label="Quick facts" class="facts">
      <dl>
        <div>
          <dt>Level</dt>
          <dd>{data.difficulty}</dd>
        </div>
        <div>
          <dt>Time</dt>
          <dd>{data.prepTimeMinutes} min</dd>
        </div>
        <div>
          <dt>Serving</dt>
          <dd>{data.vessel.sizeOz ? `${data.vessel.sizeOz} oz` : "—"}</dd>
        </div>
        <div>
          <dt>Serve</dt>
          <dd>{data.serveTemp}</dd>
        </div>
      </dl>
      <p class="facts__note">
        Serve in {data.vessel.name.toLowerCase()}.
        {data.vessel.note ? ` ${data.vessel.note}` : ""}
      </p>
    </section>

    <section class="intro">
      <p>{data.intro}</p>
    </section>

    <CoffeeIngredients
      client:load
      ingredients={data.ingredients}
      baseServings={data.servings}
    />

    <section aria-labelledby="eq-h" class="equipment">
      <h2 id="eq-h">Equipment</h2>
      <ul>
        {
          data.equipment.map((eq) => (
            <li>
              <span class="equipment__item">{eq.item}</span>
              {eq.alternative && (
                <span class="equipment__alt">
                  {altLabel(eq.item, eq.alternative)}
                </span>
              )}
            </li>
          ))
        }
      </ul>
    </section>

    <section aria-labelledby="steps-h" class="method">
      <div class="method__head">
        <h2 id="steps-h">Method</h2>
        <a class="method__brew" href={`/coffee/${slug}/guide`}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="13" r="8"></circle><path d="M12 9v4l2.5 2M10 2h4"></path></svg>
          Brew mode
        </a>
      </div>
      <ol>
        {
          data.steps.map((step, i) => (
            <li>
              <span class="method__num" aria-hidden="true">{i + 1}</span>
              <div>
                <h3>{step.title}</h3>
                <p>{step.body}</p>
                {step.tip && (
                  <p class="method__tip">
                    <strong>Tip · </strong>
                    {step.tip}
                  </p>
                )}
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    {
      data.dialIn && (
        <section aria-labelledby="dial-h" class="dial">
          <div class="dial__card">
            <div class="dial__head">
              <h2 id="dial-h">Dial it in</h2>
              <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent-soft)" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 12l4-4M12 3v2M21 12h-2M12 21v-2M3 12h2"></path></svg>
            </div>
            <dl>
              {data.dialIn.doseGrams != null && (
                <div>
                  <dt>Dose</dt>
                  <dd>{data.dialIn.doseGrams} g</dd>
                </div>
              )}
              {data.dialIn.yieldGrams != null && (
                <div>
                  <dt>Yield</dt>
                  <dd>{data.dialIn.yieldGrams} g</dd>
                </div>
              )}
              {data.dialIn.timeSeconds && (
                <div>
                  <dt>Time</dt>
                  <dd>{data.dialIn.timeSeconds.replace("-", "–")} s</dd>
                </div>
              )}
              {data.dialIn.waterTempF != null && (
                <div>
                  <dt>Water</dt>
                  <dd>
                    {data.dialIn.waterTempF}°F{" "}
                    <span>{fToC(data.dialIn.waterTempF)}°C</span>
                  </dd>
                </div>
              )}
              {data.dialIn.milkTempF != null && (
                <div>
                  <dt>Milk</dt>
                  <dd>
                    {data.dialIn.milkTempF}°F{" "}
                    <span>{fToC(data.dialIn.milkTempF)}°C</span>
                  </dd>
                </div>
              )}
              {data.dialIn.grind && (
                <div class="dial__grind">
                  <dt>Grind</dt>
                  <dd>{data.dialIn.grind}</dd>
                </div>
              )}
            </dl>
            <p class="dial__note">
              Treat these numbers as a starting point — beans and machines vary.
            </p>
          </div>
        </section>
      )
    }

    {
      data.homeMethods && data.homeMethods.length > 0 && (
        <MethodSwitcher client:load homeMethods={data.homeMethods} />
      )
    }

    <section aria-labelledby="tips-h" class="tips">
      {
        data.commonMistakes.length > 0 && (
          <>
            <h2 id="tips-h">Common mistakes</h2>
            <ul class="tips__list">
              {data.commonMistakes.map((t) => (
                <li>
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--color-ink)" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6.5 6.5l11 11M17.5 6.5l-11 11"></path></svg>
                  <p>{t}</p>
                </li>
              ))}
            </ul>
          </>
        )
      }
      <h2 class={data.commonMistakes.length ? "tips__sub" : undefined} id={data.commonMistakes.length ? "good-h" : "tips-h"}>
        Good to know
      </h2>
      <ul class="tips__list">
        {
          data.tips.map((t) => (
            <li>
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent-ink)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg>
              <p>{t}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section aria-labelledby="var-h" class="variations">
      <h2 id="var-h">Variations</h2>
      <ul>
        {
          data.variations.map((v) => (
            <li>
              <h3>{v.name}</h3>
              <p>{v.description}</p>
            </li>
          ))
        }
      </ul>
    </section>

    {
      flavorAxes.length > 0 && (
        <section aria-labelledby="flavor-h" class="flavor">
          <h2 id="flavor-h">Flavor profile</h2>
          <ul>
            {flavorAxes.map(([axis, n]) => (
              <li aria-label={`${n} out of 5`}>
                <span class="flavor__label">{titleCaseTag(axis)}</span>
                <span class="flavor__dots" aria-hidden="true">
                  {Array.from({ length: 5 }, (_, i) => (
                    <span class:list={["flavor__dot", i < n && "flavor__dot--on"]} />
                  ))}
                </span>
                <span class="flavor__n">{n}/5</span>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section aria-labelledby="more-h" class="more">
      <div class="more__head">
        <h2 id="more-h">More coffee</h2>
        <a href="/coffee">See all</a>
      </div>
      <ul class="more__grid">
        {
          related.slice(0, 4).map((r) => (
            <li>
              <DrinkTile
                name={r.data.name}
                meta={r.data.tags.map(titleCaseTag).join(" · ")}
                href={`/coffee/${r.id}`}
                serveTemp={r.data.serveTemp}
                heroImage={r.data.heroImage}
              />
            </li>
          ))
        }
      </ul>
    </section>

    <div class="sticky-bar">
      <a href={`/coffee/${slug}/guide`}>
        Start brew mode
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
      </a>
    </div>
  </main>

  <CoffeeFooter />
</CoffeeLayout>

<style>
  .title {
    padding: 12px 16px 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 12px;
  }

  .title h1 {
    font-size: 3.125rem;
    line-height: 1.02;
  }

  .title__tagline {
    font-size: 0.8125rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    color: var(--color-accent-ink);
  }

  .title__tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
  }

  .title__tags li {
    padding: 6px 14px;
    border-radius: 999px;
    background: var(--color-secondary-soft);
    color: var(--color-secondary);
    font-size: 0.875rem;
    font-weight: 700;
  }

  .hero {
    padding: 20px 16px 0;
  }

  .hero figure {
    margin: 0;
    position: relative;
    background: var(--color-surface);
    border-radius: 24px;
    box-shadow: var(--shadow-card);
    padding: 20px 16px 16px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  .hero__inset {
    position: absolute;
    inset: 8px;
    border: 1px solid var(--color-rule);
    border-radius: 18px;
  }

  .hero img {
    position: relative;
    display: block;
    width: 280px;
    max-width: 80%;
    height: 250px;
    object-fit: contain;
  }

  .hero figcaption {
    position: relative;
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--color-ink-muted);
  }

  .facts {
    padding: 20px 16px 0;
  }

  .facts dl {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 8px;
  }

  .facts dl > div {
    padding: 12px 4px;
    background: var(--color-surface);
    border-radius: 16px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    text-align: center;
    box-shadow: 0 1px 2px rgba(43, 29, 20, 0.06);
  }

  .facts dt {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-ink-muted);
  }

  .facts dd {
    margin: 0;
    font-weight: 800;
    font-size: 0.9375rem;
    line-height: 1.3;
  }

  .facts__note {
    margin: 10px 4px 0;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--color-ink-muted);
  }

  .intro {
    padding: 24px 16px 0;
  }

  .intro p {
    font-size: 1.125rem;
    line-height: 1.7;
  }

  .equipment {
    padding: 36px 16px 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .equipment h2,
  .method h2,
  .tips h2,
  .variations h2,
  .flavor h2,
  .more h2 {
    font-size: 1.875rem;
    line-height: 1.15;
  }

  .equipment ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .equipment li {
    padding: 14px 16px;
    background: var(--color-surface);
    border-radius: 16px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .equipment__item {
    font-weight: 800;
    line-height: 1.4;
  }

  .equipment__alt {
    align-self: flex-start;
    padding: 4px 12px;
    border-radius: 999px;
    background: var(--color-secondary-soft);
    color: var(--color-secondary);
    font-size: 0.875rem;
    font-weight: 700;
    line-height: 1.4;
  }

  .method {
    padding: 40px 16px 0;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .method__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .method__brew {
    min-height: var(--tap-min);
    padding: 0 16px;
    display: flex;
    align-items: center;
    gap: 8px;
    border-radius: 999px;
    background: var(--color-surface-2);
    color: var(--color-ink);
    text-decoration: none;
    font-size: 0.9375rem;
    font-weight: 800;
  }

  .method__brew:hover {
    color: var(--color-ink);
  }

  .method ol {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .method ol > li {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr);
    column-gap: 14px;
  }

  .method__num {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--color-accent);
    color: var(--color-on-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.25rem;
  }

  .method h3 {
    margin: 6px 0 0;
    font-size: 1.3125rem;
    line-height: 1.25;
  }

  .method__tip {
    margin: 8px 0 0;
    padding: 12px 14px;
    background: var(--color-surface-2);
    border-radius: 14px;
    font-size: 1rem;
    line-height: 1.55;
  }

  .method__tip strong {
    color: var(--color-accent-ink);
  }

  .dial {
    padding: 40px 16px 0;
  }

  .dial__card {
    background: var(--color-inverse);
    color: var(--color-on-inverse);
    border-radius: 24px;
    padding: 24px 20px;
    display: flex;
    flex-direction: column;
    gap: 18px;
    box-shadow: 0 10px 28px rgba(43, 29, 20, 0.18);
  }

  .dial__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .dial__card h2 {
    font-size: 1.75rem;
    color: var(--color-on-inverse);
  }

  .dial dl {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .dial dl > div {
    padding: 12px 14px;
    background: var(--color-inverse-raised);
    border-radius: 14px;
  }

  .dial dt {
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--color-on-inverse-muted);
  }

  .dial dd {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.625rem;
    line-height: 1.2;
  }

  .dial dd span {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-on-inverse-muted);
  }

  .dial__grind {
    grid-column: 1 / -1;
  }

  .dial__grind dd {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.5;
  }

  .dial__note {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--color-on-inverse-muted);
  }

  .tips {
    margin-top: 40px;
    padding: 36px 16px;
    background: var(--color-surface-2);
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .tips__sub {
    margin-top: 8px;
    font-size: 0.8125rem !important;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
    font-family: var(--font-body) !important;
  }

  .tips__list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .tips__list li {
    display: grid;
    grid-template-columns: 28px minmax(0, 1fr);
    column-gap: 10px;
  }

  .variations {
    padding: 40px 16px 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .variations ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .variations li {
    padding: 16px;
    background: var(--color-surface);
    border-radius: 16px;
    box-shadow: 0 1px 2px rgba(43, 29, 20, 0.06);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .variations h3 {
    font-size: 1.3125rem;
  }

  .variations p {
    color: var(--color-ink-muted);
  }

  .flavor {
    padding: 40px 16px 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .flavor ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 16px;
    background: var(--color-surface);
    border-radius: 20px;
    box-shadow: var(--shadow-card);
  }

  .flavor li {
    display: grid;
    grid-template-columns: 72px 1fr auto;
    align-items: center;
    gap: 12px;
  }

  .flavor__label {
    font-weight: 800;
  }

  .flavor__dots {
    display: flex;
    gap: 6px;
  }

  .flavor__dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: 1.5px solid var(--color-accent);
    background: transparent;
  }

  .flavor__dot--on {
    background: var(--color-accent);
  }

  .flavor__n {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-ink-muted);
  }

  .more {
    padding: 40px 16px 32px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .more__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
  }

  .more__head a {
    min-height: var(--tap-min);
    display: flex;
    align-items: center;
    font-size: 0.9375rem;
    font-weight: 700;
  }

  .more__grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .sticky-bar {
    position: sticky;
    bottom: 0;
    padding: 12px 16px 16px;
    background: rgba(245, 237, 224, 0.96);
    border-top: 1px solid var(--color-rule);
  }

  .sticky-bar a {
    height: var(--btn-h);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    background: var(--color-accent);
    color: var(--color-on-accent);
    border-radius: 999px;
    text-decoration: none;
    font-size: 1rem;
    font-weight: 800;
    box-shadow: var(--shadow-primary);
  }

  .sticky-bar a:hover {
    color: var(--color-on-accent);
  }
</style>
