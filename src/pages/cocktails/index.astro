---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/ui/SiteHeader.astro";
import SiteFooter from "../../components/ui/SiteFooter.astro";
import CocktailLibrary from "../../components/cocktail/CocktailLibrary";
import { getAllCocktails, spiritFromTags } from "../../lib/cocktails";
import { site } from "../../lib/site";

const cocktails = await getAllCocktails();
const drinks = cocktails.map((c) => ({
  slug: c.id,
  name: c.data.name,
  tags: c.data.tags,
  heroImage: c.data.heroImage,
  spirit: spiritFromTags(c.data.tags),
}));

const spirits = [...new Set(drinks.map((d) => d.spirit))].sort((a, b) =>
  a.localeCompare(b),
);
---

<BaseLayout
  title={`${site.brand} · Cocktail Library`}
  description="Tap a coaster, or pick a drink below. Classic cocktail recipes with clear steps for home bartenders."
  canonicalPath="/cocktails"
>
  <div class="page-shell">
    <SiteHeader variant="library" />
    <CocktailLibrary client:load drinks={drinks} spirits={spirits} />
    <SiteFooter variant="cocktail" />
  </div>
</BaseLayout>
