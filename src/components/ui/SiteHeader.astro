---
import { site } from "../../lib/site";

interface Props {
  /** home = company directory; library = cocktail list; recipe = cocktail detail */
  variant?: "home" | "library" | "recipe";
}

const { variant = "recipe" } = Astro.props;
const showDrinkIcon = variant === "library" || variant === "recipe";
---

<header class="site-header">
  {
    variant === "home" ? (
      <span class="site-header__brand">{site.brand}</span>
    ) : (
      <a class="site-header__brand" href="/">
        {showDrinkIcon && (
          <svg
            class="site-header__icon"
            width="22"
            height="22"
            viewBox="0 0 24 24"
            fill="none"
            stroke="var(--accent)"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M4 3h16l-8 11v5" />
            <path d="M9 19h6" />
            <path d="M7 7h10" />
          </svg>
        )}
        Bar
      </a>
    )
  }
  {
    variant === "home" || variant === "library" ? (
      <nav class="site-header__actions" aria-label="Site">
        <a class="site-header__cta" href="/">
          Other Products
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg>
        </a>
        <a
          class="site-header__shop"
          href={site.shopUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 7h12l-1 12H7L6 7z"></path><path d="M9 7a3 3 0 0 1 6 0"></path></svg>
          Shop
        </a>
      </nav>
    ) : (
      <nav class="site-header__actions" aria-label="Site">
        <a class="site-header__link" href="/cocktails">
          All cocktails
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg>
        </a>
        <a
          class="site-header__shop"
          href={site.shopUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 7h12l-1 12H7L6 7z"></path><path d="M9 7a3 3 0 0 1 6 0"></path></svg>
          Shop
        </a>
      </nav>
    )
  }
</header>

<style>
  .site-header {
    background: var(--slate-800);
    height: 56px;
    padding: 0 var(--gutter);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    border-bottom: 1px solid var(--slate-700);
  }

  .site-header__brand {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--paper-50);
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.25rem;
    letter-spacing: 0.02em;
    min-width: 0;
  }

  .site-header__icon {
    flex-shrink: 0;
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }

  .site-header__link {
    min-height: var(--tap-min);
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--paper-50);
    text-decoration: none;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .site-header__link:hover {
    color: var(--paper-50);
  }

  .site-header__cta {
    min-height: 40px;
    padding: 0 12px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    border-radius: 4px;
    background: var(--accent);
    color: var(--slate-900);
    text-decoration: none;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    box-shadow: 0 2px 0 rgba(0, 0, 0, 0.25);
    transition: transform 120ms ease, box-shadow 120ms ease, filter 120ms ease;
    white-space: nowrap;
  }

  .site-header__cta:hover {
    color: var(--slate-900);
    filter: brightness(1.08);
    transform: translateY(-1px);
    box-shadow: 0 3px 0 rgba(0, 0, 0, 0.28);
  }

  .site-header__cta:active {
    transform: translateY(1px);
    box-shadow: 0 1px 0 rgba(0, 0, 0, 0.2);
  }

  .site-header__shop {
    min-height: 40px;
    padding: 0 12px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    border-radius: 4px;
    border: 1.5px solid var(--paper-200);
    background: transparent;
    color: var(--paper-50);
    text-decoration: none;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: transform 120ms ease, background 120ms ease, border-color 120ms ease;
    white-space: nowrap;
  }

  .site-header__shop:hover {
    color: var(--paper-50);
    background: rgba(255, 255, 255, 0.08);
    border-color: var(--paper-50);
    transform: translateY(-1px);
  }

  .site-header__shop:active {
    transform: translateY(1px);
  }

  @media (max-width: 380px) {
    .site-header__cta,
    .site-header__shop {
      padding: 0 10px;
      font-size: 0.6875rem;
      letter-spacing: 0.04em;
    }

    .site-header__cta svg,
    .site-header__shop svg {
      display: none;
    }
  }
</style>
