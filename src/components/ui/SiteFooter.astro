---
import { site } from "../../lib/site";

interface Props {
  showNav?: boolean;
}

const { showNav = true } = Astro.props;
---

<footer class="site-footer">
  <div class="diamond-rule diamond-rule--muted diamond-rule--brass" aria-hidden="true" style="width: 100%">
    <span></span><span></span><span></span>
  </div>
  <p class="site-footer__headline">Drink responsibly.</p>
  <p>
    Enjoy in moderation and only if you're of legal drinking age. Never drink and
    drive.
  </p>
  {
    showNav && (
      <nav aria-label="Footer" class="site-footer__nav">
        <a href="/">All cocktails</a>
        <a href={site.shopUrl}>Shop coasters</a>
      </nav>
    )
  }
  <p class="site-footer__copy">© {site.year} {site.brand}</p>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    background: var(--slate-900);
    color: #e4ded1;
    padding: var(--space-6) var(--gutter) var(--space-7);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .site-footer__headline {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--paper-50);
    text-align: center;
  }

  .site-footer p {
    text-align: center;
  }

  .site-footer__nav {
    display: flex;
    justify-content: center;
    gap: var(--space-5);
  }

  .site-footer__nav a {
    min-height: var(--tap-min);
    display: flex;
    align-items: center;
    color: var(--paper-50);
    text-decoration: none;
  }

  .site-footer__nav a:hover {
    color: var(--accent);
  }

  .site-footer__copy {
    font-size: 0.8125rem;
    color: var(--on-dark-muted);
  }
</style>
