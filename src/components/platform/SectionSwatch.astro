---
interface Props {
  theme?: "cocktail" | "coffee";
  icon: "glass" | "bean" | "book" | "puzzle";
  dashed?: boolean;
}

const { theme, icon, dashed = false } = Astro.props;
---

<div
  class:list={[
    "section-swatch",
    theme && `section-swatch--${theme}`,
    dashed && "section-swatch--dashed",
  ]}
  data-theme={theme}
  aria-hidden="true"
>
  {
    icon === "glass" && (
      <svg
        width="34"
        height="34"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M4 4h16l-8 9z" />
        <path d="M12 13v7M8 20h8" />
        <path d="M15 4l2-2" />
      </svg>
    )
  }
  {
    icon === "bean" && (
      <svg
        width="34"
        height="34"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
      >
        <ellipse
          cx="12"
          cy="12"
          rx="6.5"
          ry="9"
          transform="rotate(35 12 12)"
        />
        <path d="M8.2 17.5c1.5-2.5 1.2-4.6 2.9-6.3 1.6-1.6 3.3-2.3 4.7-5" />
      </svg>
    )
  }
  {
    icon === "book" && (
      <svg
        width="32"
        height="32"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M12 6c-2-1.5-5-2-8-1.5v13c3-.5 6 0 8 1.5 2-1.5 5-2 8-1.5v-13c-3-.5-6 0-8 1.5z" />
        <path d="M12 6v13" />
      </svg>
    )
  }
  {
    icon === "puzzle" && (
      <svg
        width="32"
        height="32"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M5 9h3a2 2 0 1 1 4 0h3v3a2 2 0 1 1 0 4v3h-3a2 2 0 1 0-4 0H5v-3a2 2 0 1 0 0-4z" />
      </svg>
    )
  }
</div>

<style>
  .section-swatch {
    width: 76px;
    height: 76px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    color: var(--color-ink-muted);
  }

  .section-swatch--cocktail {
    border-radius: 4px;
    background: var(--swatch-cocktail-bg);
    color: var(--swatch-cocktail-icon);
  }

  .section-swatch--cocktail::after {
    content: "";
    position: absolute;
    inset: 5px;
    border: 1px solid var(--swatch-cocktail-frame);
    pointer-events: none;
  }

  .section-swatch--coffee {
    border-radius: 18px;
    background: var(--swatch-coffee-bg);
    color: var(--swatch-coffee-icon);
    box-shadow: inset 0 0 0 1px var(--swatch-coffee-ring);
  }

  .section-swatch--dashed {
    border-radius: 12px;
    border: 1.5px dashed var(--color-rule-dashed);
    background: transparent;
    color: var(--color-ink-muted);
  }

  .section-swatch svg {
    position: relative;
    z-index: 1;
  }
</style>
