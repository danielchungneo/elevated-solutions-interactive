---
import type { PlatformSection } from "../../lib/platform";
import { sectionCountLabel } from "../../lib/platform";
import SectionSwatch from "./SectionSwatch.astro";

interface Props {
  section: PlatformSection;
  index: number;
  catalogCount?: number;
}

const { section, index, catalogCount = 0 } = Astro.props;
const isLive = section.status === "live" && section.href;
const label = isLive
  ? sectionCountLabel(index, catalogCount, section.countLabel)
  : undefined;
---

{
  isLive ? (
    <li>
      <a class="section-card section-card--live" href={section.href}>
        <SectionSwatch theme={section.swatch} icon={section.icon} />
        <div class="section-card__text">
          <span class="section-card__label">{label}</span>
          <span class="section-card__title">{section.title}</span>
          <span class="section-card__desc">{section.description}</span>
        </div>
        <span class="section-card__arrow" aria-hidden="true">
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </span>
      </a>
    </li>
  ) : (
    <li
      class="section-card section-card--soon"
      aria-label={`${section.title}, coming soon`}
    >
      <SectionSwatch icon={section.icon} dashed />
      <div class="section-card__text section-card__text--soon">
        <span class="section-card__badge">In the workshop</span>
        <span class="section-card__title">{section.title}</span>
        <span class="section-card__desc">{section.description}</span>
      </div>
    </li>
  )
}

<style>
  .section-card--live {
    padding: 14px;
    display: grid;
    grid-template-columns: 76px minmax(0, 1fr) 40px;
    column-gap: 14px;
    align-items: center;
    background: var(--color-surface);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-card);
    color: var(--color-ink);
    text-decoration: none;
    box-shadow: var(--shadow-card);
  }

  .section-card--live:hover {
    color: var(--color-ink);
  }

  .section-card--soon {
    padding: 14px;
    display: grid;
    grid-template-columns: 76px minmax(0, 1fr);
    column-gap: 14px;
    align-items: center;
    border: 1.5px dashed var(--color-rule-dashed);
    border-radius: var(--radius-card);
    list-style: none;
  }

  .section-card__text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .section-card__text--soon {
    gap: 4px;
  }

  .section-card__label {
    font-family: var(--font-label);
    font-weight: 600;
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  .section-card__badge {
    align-self: flex-start;
    padding: 2px 8px;
    border-radius: var(--radius-pill);
    background: var(--color-accent-soft);
    color: var(--color-badge-ink);
    font-family: var(--font-label);
    font-weight: 600;
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .section-card__title {
    font-family: var(--font-display);
    font-weight: var(--weight-display);
    font-size: 1.4375rem;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .section-card--soon .section-card__title {
    color: var(--color-ink-soft);
  }

  .section-card__desc {
    font-size: 0.9375rem;
    line-height: 1.45;
    color: var(--color-ink-soft);
  }

  .section-card--soon .section-card__desc {
    color: var(--color-ink-muted);
  }

  .section-card__arrow {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--color-primary);
    color: var(--color-on-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
</style>
